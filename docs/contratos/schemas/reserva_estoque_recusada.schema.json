{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/davicalvarenga/Sistema-MicServ-SD/docs/contratos/schemas/reserva_estoque_recusada.schema.json",
  "title": "reserva_estoque_recusada (proposta)",
  "description": "PROPOSTA: o kit não tem tópico para falha de reserva (P-16). Avisa o pedidos-service que a reserva não foi feita. Chave pedidoId, para Pedidos processar na ordem dos eventos do mesmo pedido.",
  "type": "object",
  "required": [
    "eventId",
    "eventType",
    "eventVersion",
    "timestamp",
    "source",
    "correlationId",
    "aggregateId",
    "payload"
  ],
  "additionalProperties": false,
  "properties": {
    "eventId": {
      "type": "string",
      "format": "uuid",
      "description": "Identificador único do evento. Usado na idempotência (processed_events)."
    },
    "eventType": {
      "const": "reserva_estoque_recusada"
    },
    "eventVersion": {
      "const": "1.0"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "Momento da publicação, ISO-8601 em UTC."
    },
    "source": {
      "const": "fornecimentos-service"
    },
    "correlationId": {
      "type": "string",
      "format": "uuid",
      "description": "Vem do cabeçalho X-Correlation-Id da requisição que originou o evento."
    },
    "aggregateId": {
      "type": "string",
      "minLength": 1,
      "description": "Chave da mensagem no Kafka: pedidoId."
    },
    "payload": {
      "type": "object",
      "required": [
        "pedidoId",
        "fornecimentoId",
        "quantidadeSolicitada",
        "quantidadeDisponivel",
        "motivo",
        "recusadoEm"
      ],
      "properties": {
        "pedidoId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "fornecimentoId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "quantidadeSolicitada": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "Até 2 casas decimais (NUMERIC(12,2)). A precisão é validada pelo serviço, não pelo schema, porque multipleOf com decimais falha por arredondamento de ponto flutuante."
        },
        "quantidadeDisponivel": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0,
              "description": "Até 2 casas decimais (NUMERIC(12,2))."
            },
            {
              "type": "null"
            }
          ]
        },
        "motivo": {
          "enum": [
            "ESTOQUE_INSUFICIENTE",
            "FORNECIMENTO_INEXISTENTE"
          ]
        },
        "recusadoEm": {
          "type": "string",
          "format": "date-time"
        }
      },
      "additionalProperties": false
    }
  }
}
